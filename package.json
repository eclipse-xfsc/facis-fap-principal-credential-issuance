{
  "name": "facis-fap-principal-credential-issuance",
  "private": true,
  "version": "0.5.0-rc.16",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "build:ui": "node tools/build-ui.mjs",
    "build:flows": "node tools/build-flows.mjs",
    "test": "npm run test:ci",
    "test:static": "node --test test/tests/static/*.test.mjs",
    "test:bdd": "node --test test/tests/bdd/*.test.mjs",
    "test:integration": "node --test test/tests/integration/*.test.mjs",
    "test:ci": "npm run build && npm run test:static && npm run test:bdd && npm run test:integration",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "test:offline": "node tools/validate-offline.mjs",
    "format:check": "node tools/format-source.mjs --check backend src shared tools test build.js",
    "format": "node tools/format-source.mjs backend src shared tools test build.js",
    "preview:fixture": "node tools/preview-fixture.mjs",
    "test:browser:dom": "node test/browser/dom-smoke.mjs",
    "test:ux-summary": "python3 -B -m unittest discover -s test/ux-runner -p test_*.py",
    "check:maintainability": "node tools/check-maintainability.mjs",
    "check:headers": "node tools/add-licence-headers.mjs --check"
  },
  "dependencies": {
    "jsonwebtoken": "9.0.2",
    "jwks-rsa": "3.2.0",
    "nodemailer": "10.0.9",
    "pg": "8.16.3",
    "vue": "3.5.43",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "acorn": "8.15.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
