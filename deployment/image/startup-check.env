# Environment of the start-up check in .github/workflows/image.yml: the smallest
# configuration under which the PCI Function nodes load and /healthz answers.
# Every value is synthetic; no service behind these names exists in the check,
# and /readyz is expected to report the database and native listener as
# unavailable. Not a deployment configuration.
PCI_MAIN_HOST=pci.example.com
PCI_BASE_DOMAIN=example.com
PCI_ORCE_BASE_PATH=
PCI_VERIFICATION_TOKEN_PEPPER=startup-check-only-not-a-secret
PCI_DATABASE_URL=postgres://startup-check@127.0.0.1:5432/startup-check
PCI_OCM_NAMESPACE=ocm-wstack
PCI_KEYCLOAK_INTERNAL_URL=http://keycloak.startup-check.invalid
PCI_KEYCLOAK_PUBLIC_URL=https://identity.startup-check.invalid
PCI_KEYCLOAK_REALM=pci
PCI_KEYCLOAK_UI_CLIENT_ID=fap-pci-ui
